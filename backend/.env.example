# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# Frontend URL used for CORS — no trailing slash.
# Production: set this to your Vercel deployment URL, e.g. https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET=super_secret_erp_crm_jwt_key_2026_change_in_production
JWT_EXPIRES_IN=24h

# ─── Database (individual connection params) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=mini_erp_crm

# ─── Database (alternative: single connection URL, e.g. Aiven / Railway) ──────
# If set, DATABASE_URL takes precedence over the individual params above.
# DATABASE_URL=mysql://user:password@host:port/mini_erp_crm

# ─── SSL (for Aiven cloud MySQL) ──────────────────────────────────────────────
# Paste the CA certificate PEM content here if your cloud DB requires it.
# DB_CA_CERT=
